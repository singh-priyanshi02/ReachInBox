# Example environment variables for ReachInbox

# PostgreSQL
POSTGRES_URL=postgresql://user:password@postgres:5432/reachinbox

# Redis
REDIS_URL=redis://redis:6379

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://elasticsearch:9200

# Ethereal SMTP (testing)
ETHEREAL_USER=your_ethereal_user
ETHEREAL_PASS=your_ethereal_pass

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Slack OAuth / webhook
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET

# Rate limiting
MAX_EMAILS_PER_HOUR=200
MIN_SEND_DELAY_MS=2000

# Misc
QUEUE_DASHBOARD_TOKEN=supersecrettoken
